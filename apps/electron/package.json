{
  "name": "@gouxuan/electron",
  "version": "0.1.0",
  "private": true,
  "description": "钩玄桌面客户端",
  "license": "AGPL-3.0-only",
  "author": "openchic",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "pnpm typecheck && electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac dmg zip",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.5",
    "@astryxdesign/theme-neutral": "^0.6.5",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-router": "^1.170.41"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
