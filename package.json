{
  "name": "gouxuan",
  "version": "0.1.0",
  "private": true,
  "description": "钩玄 · 基于 RAG 的保险咨询问答系统",
  "license": "AGPL-3.0-only",
  "author": "openchic",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && turbo run typecheck",
    "check:api": "uv --directory services/api run ruff check . && uv --directory services/api run ruff format --check . && uv --directory services/api run pyright && uv --directory services/api run pytest -q && uv --directory services/api run python -m app.openapi | diff -q - services/api/openapi.json",
    "dev": "turbo run dev",
    "dev:api": "docker compose up api",
    "format": "prettier --write .",
    "format:api": "uv --directory services/api run ruff check --fix . && uv --directory services/api run ruff format .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:mac": "turbo run build:mac",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,less,md}": [
      "prettier --write"
    ],
    "*.py": [
      "uv run --project services/api ruff check --fix",
      "uv run --project services/api ruff format"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.7.4",
    "turbo": "2.11.5",
    "typescript": "^5.9.3"
  }
}
